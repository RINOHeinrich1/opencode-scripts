[Unit]
Description=Rotation du token Coder d'organisation (coder-token-rotate.mjs)
Documentation=file:///root/.config/opencode/scripts/docs/runbook-rotation-token-coder.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/node /root/.config/opencode/scripts/coder-token-rotate.mjs
StandardOutput=journal
StandardError=journal
